---
import { site } from '~/data/site';

interface Props {
  isHome?: boolean;
}

const { isHome = false } = Astro.props;

const links = [
  { label: 'Work', href: isHome ? '/#work' : '/#work' },
  { label: 'Talks', href: '/talks' },
  { label: 'About', href: '/about' },
];
---

<header
  class="sticky top-0 z-40 border-b border-hairline/60 bg-canvas/80 backdrop-blur-md supports-[backdrop-filter]:bg-canvas/65"
>
  <div class="mx-auto flex h-16 max-w-page items-center justify-between gap-4 px-gutter">
    <a
      href="/"
      class="font-mono text-small font-medium tracking-tight text-ink transition-colors hover:text-accent"
      aria-label={`${site.name} — home`}
    >
      sajid<span class="text-faint">alam</span>
    </a>

    <nav aria-label="Primary">
      <ul class="flex items-center gap-1 sm:gap-2">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                class="rounded px-2.5 py-1.5 text-small text-muted transition-colors hover:text-ink sm:px-3"
              >
                {link.label}
              </a>
            </li>
          ))
        }
        {/* Below 380px the four links no longer fit on one line. GitHub is the
            one to drop — it is reachable from the footer and the contact block. */}
        <li class="hidden min-[380px]:block">
          <a
            href={site.github}
            rel="me noopener"
            target="_blank"
            class="ml-1 rounded px-2.5 py-1.5 text-small text-muted transition-colors hover:text-ink sm:px-3"
          >
            GitHub<span class="sr-only"> (opens in a new tab)</span>
          </a>
        </li>
      </ul>
    </nav>
  </div>
</header>
